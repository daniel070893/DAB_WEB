<div class="contenedor-sm">

  <div class="portal-header">
    <div class="portal-icono">📄</div>
    <h1>Factura tu compra</h1>
    <p class="portal-subtitulo">
      Ingresa tu folio de compra y datos fiscales para descargar tu factura electrónica (CFDI 4.0)
    </p>
  </div>

  @if (resultadoFactura()) {
    <!-- Éxito: Mostrar mensaje y enlaces de descarga -->
    <div class="card card-padding resultado-exito">
      <div class="exito-icono">✓</div>
      <h2>¡Factura generada con éxito!</h2>
      <p>Hemos enviado los archivos PDF y XML al correo: <strong>{{ emailFacturacion() }}</strong></p>

      <div class="descargas">
        <a [href]="resultadoFactura()!.pdf" target="_blank" class="btn btn-primario btn-descarga">
          📥 Descargar PDF
        </a>
        <a [href]="resultadoFactura()!.xml" target="_blank" class="btn btn-vacio btn-descarga">
          📥 Descargar XML
        </a>
      </div>

      <div class="exito-detalles">
        <div class="detalle-fila">
          <span>Total facturado:</span>
          <strong>{{ resultadoFactura()!.total | currency:'MXN' }}</strong>
        </div>
        <div class="detalle-fila">
          <span>Fecha:</span>
          <strong>{{ resultadoFactura()!.fecha | date:'dd/MM/yyyy HH:mm' }}</strong>
        </div>
      </div>

      <button (click)="limpiarFormulario()" class="btn btn-blanco btn-ancho" style="margin-top: 20px;">
        Facturar otra compra
      </button>
    </div>
  } @else {
    <!-- Formulario de facturación -->
    <div class="card card-padding">
      <form [formGroup]="facturaForm" (ngSubmit)="generarFactura()">

        <div class="seccion-formulario">
          <h3>Datos de la compra</h3>

          <div class="campo-grupo">
            <label for="ticketId">Folio de compra *</label>
            <input
              type="text"
              id="ticketId"
              class="input input-ancho"
              formControlName="ticketId"
              placeholder="Ej. 20260901-A1B2C3"
              [class.input-error]="f['ticketId'].touched && f['ticketId'].invalid"
            />
            @if (f['ticketId'].touched && f['ticketId'].hasError('required')) {
              <span class="campo-error">El folio es requerido</span>
            }
          </div>
        </div>

        <div class="seccion-formulario">
          <h3>Datos fiscales</h3>

          <div class="campo-grupo">
            <label for="rfc">RFC *</label>
            <input
              type="text"
              id="rfc"
              class="input input-ancho"
              formControlName="rfc"
              placeholder="XAXX010101000"
              maxlength="13"
              (blur)="convertirMayusculas('rfc')"
              [class.input-error]="f['rfc'].touched && f['rfc'].invalid"
            />
            @if (f['rfc'].touched && f['rfc'].hasError('required')) {
              <span class="campo-error">El RFC es requerido</span>
            }
            @if (f['rfc'].touched && f['rfc'].hasError('minlength')) {
              <span class="campo-error">El RFC debe tener al menos 12 caracteres</span>
            }
          </div>

          <div class="campo-grupo">
            <label for="razonSocial">Razón Social *</label>
            <input
              type="text"
              id="razonSocial"
              class="input input-ancho"
              formControlName="razonSocial"
              placeholder="Nombre completo o razón social"
              (blur)="convertirMayusculas('razonSocial')"
              [class.input-error]="f['razonSocial'].touched && f['razonSocial'].invalid"
            />
            @if (f['razonSocial'].touched && f['razonSocial'].hasError('required')) {
              <span class="campo-error">La razón social es requerida</span>
            }
          </div>

          <div class="campo-grupo">
            <label for="codigoPostal">Código Postal *</label>
            <input
              type="text"
              id="codigoPostal"
              class="input input-ancho"
              formControlName="codigoPostal"
              placeholder="72000"
              maxlength="5"
              [class.input-error]="f['codigoPostal'].touched && f['codigoPostal'].invalid"
            />
            @if (f['codigoPostal'].touched && f['codigoPostal'].hasError('required')) {
              <span class="campo-error">El código postal es requerido</span>
            }
            @if (f['codigoPostal'].touched && f['codigoPostal'].hasError('minlength')) {
              <span class="campo-error">El código postal debe tener 5 dígitos</span>
            }
          </div>

          <div class="fila-campos">
            <div class="campo-grupo">
              <label for="regimenFiscal">Régimen Fiscal *</label>
              <select id="regimenFiscal" class="input input-ancho" formControlName="regimenFiscal">
                @for (regimen of regimenesFiscales; track regimen.clave) {
                  <option [value]="regimen.clave">{{ regimen.clave }} - {{ regimen.descripcion }}</option>
                }
              </select>
            </div>

            <div class="campo-grupo">
              <label for="usoCfdi">Uso CFDI *</label>
              <select id="usoCfdi" class="input input-ancho" formControlName="usoCfdi">
                @for (uso of usosCfdi; track uso.clave) {
                  <option [value]="uso.clave">{{ uso.clave }} - {{ uso.descripcion }}</option>
                }
              </select>
            </div>
            <div class="campo-grupo">
              <label for="email">Correo electrónico *</label>
              <input
                type="email"
                id="email"
                class="input input-ancho"
                formControlName="email"
                placeholder="usuario@ejemplo.com"
              />
              @if (f['email'].touched && f['email'].hasError('required')) {
                <span class="campo-error">El correo es requerido</span>
              }
              @if (f['email'].touched && f['email'].hasError('email')) {
                <span class="campo-error">Correo electrónico inválido</span>
              }
            </div>
          </div>

          @if (errorMensaje()) {
            <div class="alerta alerta-error">{{ errorMensaje() }}</div>
          }

          <button
            type="submit"
            class="btn btn-primario btn-ancho btn-grande"
            [disabled]="facturaForm.invalid || cargando()"
          >
            @if (cargando()) {
              <span class="spinner-btn"></span>
              Procesando factura...
            } @else {
              Generar Factura
            }
          </button>

          <p class="nota-pie">
            Tu factura electrónica será generada al instante. Recibirás el PDF y XML para descarga.
</p>
        </form>
      </div>
    </div>
  }
</div>
